CHIP CountNegEvenGroups {
    IN in[16];
    OUT count[3];
	
    PARTS:
    // Get the 4 individual bits
    IsNegEven4(in = in[0..3], out=out1);
    IsNegEven4(in = in[4..7], out=out2);
    IsNegEven4(in = in[8..11], out=out3);
    IsNegEven4(in = in[12..15], out=out4);

    // Add out1 + out2
    HalfAdder(a=out1, b=out2, sum=sum12, carry=carry12);
    
    // Add out3 + out4
    HalfAdder(a=out3, b=out4, sum=sum34, carry=carry34);
    
    // Add the two 2-bit results: (carry12,sum12) + (carry34,sum34)
    // Bit 0: sum12 + sum34
    HalfAdder(a=sum12, b=sum34, sum=count[0], carry=carryBit0);
    
    // Bit 1: carry12 + carry34 + carryBit0 (need FullAdder!)
    FullAdder(a=carry12, b=carry34, c=carryBit0, sum=count[1], carry=count[2]);
}