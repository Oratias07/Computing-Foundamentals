// File name: projects/02/ALU.hdl
/**
 * ALU (Arithmetic Logic Unit):
 * Computes out = one of the following functions:
 *                0, 1, -1,
 *                x, y, !x, !y, -x, -y,
 *                x + 1, y + 1, x - 1, y - 1,
 *                x + y, x - y, y - x,
 *                x & y, x | y
 * on the 16-bit inputs x, y,
 * according to the input bits zx, nx, zy, ny, f, no.
 * In addition, computes the output bits:
 * zr = (out == 0, 1, 0)
 * ng = (out < 0,  1, 0)
 */
// Implementation: Manipulates the x and y inputs
// and operates on the resulting values, as follows:
// if (zx == 1) sets x = 0        // 16-bit constant
// if (nx == 1) sets x = !x       // bitwise not
// if (zy == 1) sets y = 0        // 16-bit constant
// if (ny == 1) sets y = !y       // bitwise not
// if (f == 1)  sets out = x + y  // integer 2's complement addition
// if (f == 0)  sets out = x & y  // bitwise and
// if (no == 1) sets out = !out   // bitwise not
// if (gne == 1) sets hasNegEvenGroup = 1, else 0 //
CHIP ALU {
    IN  
        x[16], y[16],  // 16-bit inputs        
        zx, // zero the x input?
        nx, // negate the x input?
        zy, // zero the y input?
        ny, // negate the y input?
        f,  // compute (out = x + y) or (out = x & y)?
        no; // negate the out output?
    OUT 
        out[16],  // 16-bit output
		hasNegEvenGroup, // at least x or y is even and negative
        zr,      // (out == 0, 1, 0)
        ng;      // (out < 0,  1, 0)

	PARTS:
		// zx, nx
		Mux16(a=x ,b=false ,sel=zx ,out=xafterzx);
		Not16(in=xafterzx, out=notx);
		Mux16(a=xafterzx ,b=notx ,sel=nx ,out=xafternx);
		
		// zy, ny
		Mux16(a=y ,b=false ,sel=zy ,out=yafterzy);
		Not16(in=yafterzy, out=noty);
		Mux16(a=yafterzy ,b=noty ,sel=ny ,out=yafterny);
		
		// f
		Add16(a=xafternx, b=yafterny, out=xory);
		And16(a=xafternx, b=yafterny, out=xandy);
		Mux16(a=xandy, b=xory, sel=f, out=tmp);
		
		// no, ng -- ng from Sign Magnitude Representation
		Not16(in=tmp, out=nottmp);
		Mux16(a=tmp, b=nottmp, sel=no, out=out, out[0..7]=zr1, out[8..15]=zr2, out[15]=ng, 
		out[0..3] = out03, out[4..7] = out47, out[8..11] = out811, out[12..15] = out1215);
	
		// zr
		Or8Way(in=zr1, out=fzr1);
		Or8Way(in=zr2, out=fzr2);
		Or(a=fzr1, b=fzr2, out=notzr);
		Not(in=notzr, out=zr);

        // check if at least one from the four groups is even and negative
		// divide to 4 groups
		IsNegEven4(a = out03, out=out1);
		IsNegEven4(a = out47, out=out2);
		IsNegEven4(a = out811, out=out3);
		IsNegEven4(a = out1215, out=out4);
		
		// check with Or gate
		Or(a = out1, b = out2, out = out1st);
	    Or(a = out3, b = out4, out = out2nd);
	    Or(a = out1st, b = out2nd, out = hasNegEvenGroup);
		

}