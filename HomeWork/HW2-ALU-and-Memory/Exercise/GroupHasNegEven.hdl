
CHIP GroupHasNegEven {
    IN in[16];
    OUT out;
	
	PARTS:
	// Check each 4-bit group if it is negative and even
	IsNegEven4(a = in[0..3], out=out1);
	IsNegEven4(a = in[4..7], out=out2);
	IsNegEven4(a = in[8..11], out=out3);
	IsNegEven4(a = in[12..15], out=out4);
	
	// OR all four results → output = 1 if any group matches
	Or(a = out1, b = out2, out=outOr1);
	Or(a = out3, b = out4, out=outOr2);
	Or(a = outOr1, b = outOr2, out=out);
}