// by Nisan and Schocken, MIT Press.

CHIP FullSub {
    IN a, b, bIn;
    OUT diff, bOut;

    PARTS:
    Not(in = b, out = notB);
    Not(in = bIn, out = notBIn);

    FullAdder(a = a, b = notB, c = notBIn, sum = diff, carry = borrowTemp);
    Not(in = borrowTemp, out = bOut);
}
