CHIP AdderSub8 {
    IN a[8], b[8], control;  
    OUT res[8], cOut, ifZero;     

    PARTS:
    AdderSub(a = a[0], b = b[0], cIn = false, control = control, res = res[0], res = res1, cOut = c0);
    AdderSub(a = a[1], b = b[1], cIn = c0, control = control, res = res[1], res = res2, cOut = c1);
    AdderSub(a = a[2], b = b[2], cIn = c1, control = control, res = res[2], res = res3, cOut = c2);
    AdderSub(a = a[3], b = b[3], cIn = c2, control = control, res = res[3], res = res4, cOut = c3);
    AdderSub(a = a[4], b = b[4], cIn = c3, control = control, res = res[4], res = res5, cOut = c4);
    AdderSub(a = a[5], b = b[5], cIn = c4, control = control, res = res[5], res = res6, cOut = c5);
    AdderSub(a = a[6], b = b[6], cIn = c5, control = control, res = res[6], res = res7, cOut = c6);
    AdderSub(a = a[7], b = b[7], cIn = c6, control = control, res = res[7], res = res8, cOut = cOut);

    Or8Way(in[0] = res1, in[1] = res2, in[2] = res3, in[3] = res4, in[4] = res5, in[5] = res6, in[6] = res7 ,in[7] = res8, out = x);
    Not(in = x, out = ifZero);
}