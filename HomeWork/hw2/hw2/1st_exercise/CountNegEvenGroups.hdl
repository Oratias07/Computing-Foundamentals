CHIP CountNegEvenGroups {
    IN in[16];
    OUT count[3];
	
	PARTS:
	// Evaluate each 4-bit group (negative & even)
	IsNegEven4(a = in[0..3], out=out1);
	IsNegEven4(a = in[4..7], out=out2);
	IsNegEven4(a = in[8..11], out=out3);
	IsNegEven4(a = in[12..15], out=out4);
	
	// Sum the four 1-bit results using HalfAdders
	HalfAdder(a = out1, b = out2, sum = sum1, carry = carry1);
	HalfAdder(a = sum1, b = out3, sum = sum2, carry = carry2);
	HalfAdder(a = sum2, b = out4, sum = sum3, carry = carry3);
	
	HalfAdder(a = carry1, b = carry2, sum = sumc12, carry = carryc);
	HalfAdder(a = sumc12, b = carry3, sum = bit1, carry = t2);
	Or(a = carryc, b = t2, out = bit12);
	
	// Final 3-bit output represents count (0–4)
	Or(a = sum3, b = false, out = count[0]);
	Or(a = bit1, b = false, out = count[1]);
	Or(a = bit12, b = false, out = count[2]);

}

